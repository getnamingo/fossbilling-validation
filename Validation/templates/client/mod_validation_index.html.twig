{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% block meta_title %}{{ 'Contact Validation'|trans }}{% endblock %}

{% block body_class %}validation{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active" aria-current="page"><a href="#">{{ 'Contact Validation'|trans }}</a></li>{% endblock %}

{% block content %}
<div class="col-md-12">
    <div class="card mb-4">
        <div class="card-header py-3 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1">{{ 'Contact Validation'|trans }}</h1>
                    <span class="small text-muted">{{ 'This page confirms the accuracy of contact information for domain registrants, as required by ICANN regulations.'|trans }}</span>
                </div>
            </div>
        </div>    
        <div class="card-body">
            {% if message is defined %}
                {% if 'Error' in message %}
                    <div class="alert alert-warning">{{ message|e }}</div>
                {% else %}
                    <div class="alert alert-info">{{ message|e }}</div>
                {% endif %}
            {% else %}
                <div class="alert alert-warning">No validation token provided in the URL.</div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}